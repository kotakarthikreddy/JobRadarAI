# ═══════════════════════════════════════════════════
# JobRadar AI v5.0 — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════

# ── AI Providers (at least one required for scoring) ──────────
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_SCORER_MODEL=gemini-2.0-flash-lite

GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Telegram (required for alerts) ───────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get your ID: message @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Google Sheets (optional — SQLite works without this) ─────
GOOGLE_SHEET_ID=12aDfDaW4LP1s97q8CJHG0GPFb1lahRCuCIus0k5Tjho
# Paste full service account JSON on one line:
GOOGLE_CREDS_JSON=

# ── Scanner Behavior ─────────────────────────────────────────
MIN_MATCH_SCORE=60
H1B_ONLY=true
SCAN_INTERVAL_MINUTES=5
MAX_ALERTS_PER_SCAN=15
DB_PATH=data/jobradar.db
